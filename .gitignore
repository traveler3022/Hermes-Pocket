*.tar.gz
*.zip
*.gz
*.tar
!app/src/main/assets/linux/alpine-minirootfs-*.tar.gz

# Build directories
build/
.gradle/
.kotlin/

# Local properties
local.properties

# Release signing — never commit the keystore or its credentials
keystore.properties
*.jks
*.keystore
# ...except the shared debug key: every debug build must be signed alike so a new
# debug APK installs over the previous one (it protects nothing; it is public on purpose).
!app/debug.keystore

# IDE
.idea/
*.iml

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
